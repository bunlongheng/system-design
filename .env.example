# ── Artifact API (mirrors the diagrams app) ───────────────────────────────────

# Secret token for the public render-only API (POST /api/ai/system-designs).
# Server-only. NEVER a NEXT_PUBLIC_*/VITE_* var, never referenced client-side.
# Generate with: openssl rand -hex 24
SYSTEM_DESIGNS_API_SECRET="your-secret-token-here"

# Shared Postgres (the "2026" Linode DB the sibling apps use, or any Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_SSL="true" # "true" for remote Postgres (rejectUnauthorized:false)

# Owner UUID used as system_designs.user_id for API-created artifacts.
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# Public base URL used to build the returned artifact URL.
SYSTEM_DESIGNS_APP_URL="https://system-design-bheng.vercel.app"

# Anthropic key - ONLY for the admin-only POST /api/ai/generate (local/owner).
ANTHROPIC_API_KEY="sk-ant-..."

# DEV-ONLY auth bypass (treats localhost/LAN as the owner). NEVER set in prod.
# LOCAL_DEV="true"

# Stickies external API key (unrelated to the artifact API).
STICKIES_TOKEN=""
